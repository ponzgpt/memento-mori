{
  "version": "1.0.0",
  "release_gate": "source-installable",
  "platforms": {
    "linux": {
      "status": "ready",
      "surface": "Waybar-compatible custom JSON module",
      "source_install": "./install.sh",
      "release_artifact": "memento-mori-linux-waybar-1.0.0.tar.gz",
      "signed_installer": false,
      "verification": [
        "python3 -m py_compile waybar/memento.py",
        "python3 waybar/memento.py --config config/profile.example.json"
      ]
    },
    "macos": {
      "status": "source-installable",
      "surface": "user-local app bundle backed by the local component app",
      "source_install": "sh installers/macos/install.sh",
      "release_artifact": "memento-mori-local-app-1.0.0.tar.gz",
      "signed_installer": false,
      "verification": [
        "npm run check:installers",
        "npm run package"
      ]
    },
    "windows": {
      "status": "source-installable",
      "surface": "Start Menu launcher backed by the local component app",
      "source_install": "powershell -ExecutionPolicy Bypass -File installers\\windows\\install.ps1",
      "release_artifact": "memento-mori-local-app-1.0.0.tar.gz",
      "signed_installer": false,
      "verification": [
        "npm run package"
      ]
    },
    "ios": {
      "status": "documented",
      "surface": "SwiftUI and WidgetKit direction",
      "source_install": null,
      "release_artifact": null,
      "signed_installer": false,
      "verification": [
        "docs/apple-platform-plan.md"
      ]
    }
  },
  "required_common_checks": [
    "npm run verify",
    "npm run audit",
    "npm run lint",
    "npm run check:version",
    "npm test",
    "npm run check:web",
    "npm run package",
    "shasum -a 256 -c dist/SHA256SUMS"
  ],
  "disclaimer": "Not medical, legal, actuarial, insurance, or mental-health advice."
}
