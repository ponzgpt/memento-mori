    "check:installers": "node scripts/check-installers.mjs",
    "check:production": "node scripts/check-production-readiness.mjs",
    "check:release": "node scripts/check-release-readiness.mjs",
    "check:version": "node scripts/check-version.mjs",
    "check:web": "node scripts/check-web.mjs",
    "lint": "node tests/lint.mjs",
    "package": "node scripts/package-release.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "test": "node tests/memento-core.test.mjs && node tests/feature-stories.mjs && node scripts/test-waybar.mjs",
    "serve": "node scripts/serve.mjs",
    "verify": "node scripts/verify-release.mjs"
  },
  "license": "Apache-2.0"
